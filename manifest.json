{
  "manifest_version": 3,
  "name": "Showdown Team Sharer",
  "version": "1.0.1",
  "description": "Adds buttons to the Pokémon Showdown teambuilder to upload the current team to Pokepast.es, VRPastes, or PokeBin.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://play.pokemonshowdown.com/*",
    "https://pokepast.es/*",
    "https://vrpaste-backend.vercel.app/*",
    "https://pokebin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
